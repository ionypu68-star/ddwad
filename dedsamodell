<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Key Generator</title>
    <style>
        body { background: #0a0a0a; color: white; font-family: sans-serif; text-align: center; padding: 50px; }
        .stage { margin: 20px; }
        button { padding: 10px 20px; margin: 10px; cursor: pointer; }
        input { padding: 8px; width: 300px; }
        .hidden { display: none; }
    </style>
</head>
<body>
    <h1>Key Generator</h1>
    <div id="stage1" class="stage">
        <p>Этап 1: Пройдите по ссылке Work.ink</p>
        <p>Часть ключа: <span id="part1"></span></p>
        <button onclick="nextStage('stage2')">Перейти ко 2-му этапу</button>
    </div>
    <div id="stage2" class="stage hidden">
        <p>Этап 2: Часть ключа: <span id="part2"></span></p>
        <button onclick="nextStage('stage3')">Перейти к 3-му этапу</button>
    </div>
    <div id="stage3" class="stage hidden">
        <p>Этап 3: Часть ключа: <span id="part3"></span></p>
        <button onclick="showFullKey()">Получить полный ключ</button>
    </div>
    <div id="fullKey" class="stage hidden">
        <h2>Ваш ключ:</h2>
        <input type="text" id="keyDisplay" readonly>
        <button onclick="copyKey()">Скопировать</button>
    </div>

    <script>
        // Заранее заданные части ключа (замени на свои)
        const PART1 = "ABC12";
        const PART2 = "DEF34";
        const PART3 = "GHI56";

        // Функция для чтения параметра token из URL
        function getTokenFromURL() {
            const params = new URLSearchParams(window.location.search);
            return params.get("token");
        }

        // Проверка токена через API Work.ink (возвращает true/false)
        async function verifyWorkInkToken(token) {
            if (!token) return false;
            try {
                const response = await fetch(`https://work.ink/_api/v2/token/isValid/${token}?deleteToken=1`);
                const data = await response.json();
                return data.valid === true;
            } catch (err) {
                console.error("Token verification failed:", err);
                return false;
            }
        }

        // Определяем, какой этап показывать на основе URL
        async function init() {
            const path = window.location.pathname;
            const token = getTokenFromURL();

            // Проверяем токен (если есть)
            if (token) {
                const isValid = await verifyWorkInkToken(token);
                if (!isValid) {
                    document.body.innerHTML = "<h2>Токен недействителен или уже использован. Пройдите этап заново.</h2>";
                    return;
                }
            }

            // Показываем нужный этап
            if (path.includes("stage1")) {
                document.getElementById("stage1").classList.remove("hidden");
                document.getElementById("part1").textContent = PART1;
            } else if (path.includes("stage2")) {
                document.getElementById("stage2").classList.remove("hidden");
                document.getElementById("part2").textContent = PART2;
            } else if (path.includes("stage3")) {
                document.getElementById("stage3").classList.remove("hidden");
                document.getElementById("part3").textContent = PART3;
            } else {
                // Главная страница — показываем первый этап
                document.getElementById("stage1").classList.remove("hidden");
                document.getElementById("part1").textContent = PART1;
            }
        }

        // Переход к следующему этапу (замени ссылки на свои Work.ink-ссылки)
        function nextStage(stage) {
            const links = {
                "stage2": "https://work.ink/ТВОЯ_ССЫЛКА_НА_ВТОРОЙ_ЭТАП",
                "stage3": "https://work.ink/ТВОЯ_ССЫЛКА_НА_ТРЕТИЙ_ЭТАП"
            };
            window.location.href = links[stage];
        }

        // Показать полный ключ
        function showFullKey() {
            const fullKey = PART1 + "-" + PART2 + "-" + PART3;
            document.getElementById("keyDisplay").value = fullKey;
            document.getElementById("fullKey").classList.remove("hidden");
        }

        // Скопировать ключ в буфер обмена
        function copyKey() {
            const keyInput = document.getElementById("keyDisplay");
            keyInput.select();
            document.execCommand("copy");
            alert("Ключ скопирован!");
        }

        // Запуск
        init();
    </script>
</body>
</html>
